# ═══════════════════════════════════════════════════════════════════════
# Legal Aid & Rights Awareness Portal — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── Database ─────────────────────────────────────────────────────────
POSTGRES_USER=legalaid
POSTGRES_PASSWORD=legalaid_secure_pw_2026
POSTGRES_DB=legalaid
DATABASE_URL=postgresql://legalaid:legalaid_secure_pw_2026@localhost:5432/legalaid?schema=public

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=legalaid_redis_pw_2026
REDIS_URL=redis://:legalaid_redis_pw_2026@localhost:6379

# ─── JWT Authentication ──────────────────────────────────────────────
# IMPORTANT: Change this to a random 64+ character string in production
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. NEVER use * in production.
CORS_ORIGINS=http://localhost:3000

# ─── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Email (Optional — for password reset) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@legalaid.example.com

# ─── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Gemini free-tier legal-answer model ────────────────────────────
# Create a free-tier API key and keep billing disabled to avoid paid usage.
# Never expose this key through a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
GEMINI_API_TIMEOUT_MS=45000
