# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://legalaid:legalaid_secure_pw_2026@localhost:5432/legalaid?schema=public"

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://:legalaid_redis_pw_2026@localhost:6379"

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET"
JWT_ACCESS_EXPIRY="60m"
JWT_REFRESH_EXPIRY="7d"

# ─── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000"

# ─── Gemini free-tier legal-answer model ────────────────────────────
# Create a free-tier API key and keep billing disabled to avoid paid usage.
# Never expose this key through a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
GEMINI_API_TIMEOUT_MS=45000

# ─── SMTP (optional — password reset emails) ──────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
